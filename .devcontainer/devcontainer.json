{
  "name": "Havre (PWA statique)",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "index.html"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "esbenp.prettier-vscode",
        "ritwickdey.LiveServer"
      ]
    }
  },
  "postAttachCommand": {
    "server": "python3 -m http.server 8501"
  },
  "portsAttributes": {
    "8501": {
      "label": "Havre",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
